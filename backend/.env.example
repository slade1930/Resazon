# ── Gemini / IA ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_OUTPUT_TOKENS=2048

# ── Base de datos ──────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL=postgresql+psycopg2://resazon:resazon@localhost:5432/resazon_loop
# Neon (producción, en Vercel usa el pooler):
# DATABASE_URL=postgresql://neondb_owner:<pass>@<proyecto>-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── App ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Producción (Vercel):
# ENVIRONMENT=production
# CORS_ALLOWED_ORIGINS=["https://resazon-loop.vercel.app"]

# ── Imágenes ───────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=8
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# ── RAG ────────────────────────────────────────────────────────────
RAG_TOP_K=5

# ── Recetario ──────────────────────────────────────────────────────
RECETARIO_PATH=data/raw/Recetario_Nuestro_Sabor_Panama_estructurado.txt
GEMINI_EMBEDDING_DIM=768
